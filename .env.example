POSTGRES_USER=avito
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=avito
POSTGRES_PORT=5432

HTTP_ADDR=:8080
DATABASE_URL=postgres://avito:local_dev_password@postgres:5432/avito?sslmode=disable
JWT_SECRET=local_dev_jwt_secret_change_me
JWT_TTL=1h
REWARD_HMAC_SECRET=local_dev_reward_secret_change_me
METRICS_TOKEN=
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_COLOR=always
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

REDIS_ADDR=redis:6379

DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s

KAFKA_BROKERS=
KAFKA_TOPIC=pet.activity
KAFKA_GROUP=pet-service
KAFKA_CLIENT_ID=pet-service
KAFKA_TIMEOUT=3s

PET_FLUSH_INTERVAL=15s
PET_FLUSH_BATCH_SIZE=100

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
REQUEST_TIMEOUT=30s

MAX_BODY_BYTES=1048576
MAX_PHOTO_BYTES=5242880
UPLOAD_DIR=/data/uploads
UPLOAD_URL=/uploads

VITE_API_URL=
VITE_DEFAULT_LOCALE=ru
