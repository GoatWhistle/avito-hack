# Значения ниже рабочие — `cp .env.example .env && docker compose up -d --build`
# поднимает стек без правок. Это локальные учебные секреты: для стенда,
# доступного извне, замените POSTGRES_PASSWORD, JWT_SECRET и REWARD_HMAC_SECRET
# (см. .env.production.example) и не забудьте про пароль внутри DATABASE_URL.
POSTGRES_USER=avito
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=avito
POSTGRES_PORT=5432

HTTP_ADDR=:8080
DATABASE_URL=postgres://avito:local_dev_password@postgres:5432/avito?sslmode=disable
JWT_SECRET=local_dev_jwt_secret_change_me
JWT_TTL=15m
REWARD_HMAC_SECRET=local_dev_reward_secret_change_me
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_COLOR=always
ALLOWED_ORIGINS=http://localhost:3000

REDIS_ADDR=redis:6379

# Пул подключений к PostgreSQL. Значения совпадают с дефолтами
# postgres.DefaultPoolOptions(), перечислены явно для наглядности.
# DB_MIN_CONNS не должен превышать DB_MAX_CONNS, иначе Load() вернёт ошибку.
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s

# Оставьте KAFKA_BROKERS пустым, чтобы события доставлялись внутрипроцессной шиной.
# Kafka-путь требует сборки с тегом: go build -tags kafka ./...
KAFKA_BROKERS=
KAFKA_TOPIC=pet.activity
KAFKA_GROUP=pet-service
KAFKA_CLIENT_ID=pet-service
KAFKA_TIMEOUT=3s

PET_FLUSH_INTERVAL=15s
PET_FLUSH_BATCH_SIZE=100

# Таймауты HTTP-сервера. Значения ниже совпадают с дефолтами internal/config,
# перечислены явно, чтобы их было видно и можно было поднять для медленной сети.
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
REQUEST_TIMEOUT=30s

MAX_BODY_BYTES=1048576
MAX_PHOTO_BYTES=5242880
UPLOAD_DIR=/data/uploads
UPLOAD_URL=/uploads

VITE_API_URL=http://localhost:8080
VITE_DEFAULT_LOCALE=ru
