# ============================================================================
# Шаблон окружения для ПРОДА. Скопировать в .env на сервере и заполнить.
#
#   cp .env.production.example .env
#
# Файл .env в .gitignore и коммититься не должен. Всё, что помечено ЗАМЕНИТЬ,
# обязательно к правке — с оставленными плейсхолдерами бэкенд либо не стартует,
# либо стартует небезопасно.
#
# Генерация секретов одной командой:
#   echo "POSTGRES_PASSWORD=$(openssl rand -base64 24 | tr -d '/+=')"
#   echo "JWT_SECRET=$(openssl rand -hex 32)"
#   echo "REWARD_HMAC_SECRET=$(openssl rand -hex 32)"
# ============================================================================

# --- База данных -----------------------------------------------------------
# Порт наружу не публикуется (prod-оверрайд обнуляет ports), postgres доступен
# только контейнерам в сети backend.
POSTGRES_USER=avito
# ЗАМЕНИТЬ: сгенерированный пароль, не словарный.
POSTGRES_PASSWORD=
POSTGRES_DB=avito

# ЗАМЕНИТЬ: пароль в строке должен побайтово совпадать с POSTGRES_PASSWORD выше.
# Хост — имя сервиса `postgres`, не localhost. sslmode=disable допустим:
# трафик не покидает docker-сеть.
DATABASE_URL=postgres://avito:ЗАМЕНИТЬ_НА_POSTGRES_PASSWORD@postgres:5432/avito?sslmode=disable

# --- Redis -----------------------------------------------------------------
REDIS_ADDR=redis:6379

# --- Пул подключений к PostgreSQL ------------------------------------------
# DB_MAX_CONNS — верхняя граница одновременных соединений от ОДНОГО инстанса
# бэкенда. Суммарно по всем инстансам не должно превышать max_connections
# постгреса (по умолчанию 100), иначе новые соединения будут отвергаться.
# DB_MIN_CONNS — тёплый резерв, держится открытым; не должен быть больше
# DB_MAX_CONNS, иначе Load() вернёт ошибку и контейнер уйдёт в рестарт-луп.
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Время жизни соединения и простоя. Пересоздание соединений страхует от
# утечек серверных ресурсов и подхватывает смену параметров постгреса.
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Период фоновой проверки живости соединений в пуле.
DB_HEALTH_CHECK_PERIOD=1m

# Таймаут установки соединения. Он же ограничивает стартовый ping: слишком
# малое значение уронит бэкенд, если постгрес поднимается дольше.
DB_CONNECT_TIMEOUT=5s

# --- Секреты приложения ----------------------------------------------------
# ЗАМЕНИТЬ: минимум 16 символов, иначе Load() в internal/config вернёт ошибку
# и контейнер backend уйдёт в рестарт-луп. Рекомендуется 64 hex-символа.
JWT_SECRET=
JWT_TTL=15m

# ЗАМЕНИТЬ: минимум 16 символов. Подписывает промокоды наград.
# ВНИМАНИЕ: смена секрета на работающем проде навсегда инвалидирует все ранее
# выданные коды — подписи перестанут сходиться. Задать один раз до демо.
REWARD_HMAC_SECRET=

# --- HTTP и CORS -----------------------------------------------------------
HTTP_ADDR=:8080

# ЗАМЕНИТЬ: точная схема + домен, через запятую без пробелов.
# Используется и для CORS, и для проверки Origin при WebSocket-рукопожатии,
# поэтому после включения HTTPS здесь должен быть https://, иначе сокет
# закроется сразу после handshake.
#   до сертификата:  http://SERVER_IP
#   после:           https://ваш-домен,https://www.ваш-домен
ALLOWED_ORIGINS=https://ваш-домен

# --- Логи ------------------------------------------------------------------
# LOG_FORMAT/LOG_COLOR в docker-compose.prod.yml жёстко переопределены на
# json/never, значения ниже влияют только на запуск без prod-оверрайда.
LOG_LEVEL=info
LOG_FORMAT=json
LOG_COLOR=never

# --- Таймауты HTTP-сервера -------------------------------------------------
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
REQUEST_TIMEOUT=30s

# --- Загрузка файлов -------------------------------------------------------
# MAX_PHOTO_BYTES (5 МБ) должен быть меньше client_max_body_size в
# deploy/nginx/nginx.conf (8m), иначе nginx отрежет запрос раньше бэкенда
# и пользователь получит 413 вместо внятной ошибки валидации.
MAX_BODY_BYTES=1048576
MAX_PHOTO_BYTES=5242880
UPLOAD_DIR=/data/uploads
UPLOAD_URL=/uploads

# --- Kafka -----------------------------------------------------------------
# Пусто = события идут внутрипроцессной шиной, брокер не нужен вообще.
# Для демо с Kafka: KAFKA_BROKERS=kafka:9092 (сервис kafka есть в
# docker-compose.yml). Порт наружу не публикуется.
KAFKA_BROKERS=
KAFKA_TOPIC=pet.activity
KAFKA_GROUP=pet-service
KAFKA_CLIENT_ID=pet-service
KAFKA_TIMEOUT=3s

PET_FLUSH_INTERVAL=15s
PET_FLUSH_BATCH_SIZE=100

# --- Фронтенд (build-time!) ------------------------------------------------
# ЗАМЕНИТЬ: эти значения вшиваются в статический бандл на этапе `npm run build`.
# Правка .env без пересборки фронтенда НИЧЕГО не изменит:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build frontend
#
# Указывать корень домена БЕЗ /api — путь /api фронтенд добавляет сам.
# Схема обязана совпадать со схемой сайта: https-страница не сможет
# обратиться к http-API (mixed content блокируется браузером).
VITE_API_URL=https://ваш-домен
VITE_DEFAULT_LOCALE=ru

# --- Certbot / Let's Encrypt ----------------------------------------------
# Читаются сервисом certbot (профиль "certbot") в docker-compose.prod.yml.
# ЗАМЕНИТЬ перед выпуском сертификата.
DOMAIN=ваш-домен
LETSENCRYPT_EMAIL=you@example.com

# --- Метаданные сборки -----------------------------------------------------
VERSION=1.0.0
COMMIT=unknown

# --- Опционально: ежедневная сводка через Claude ---------------------------
# Функция необязательная: без ключа приложение работает штатно, сводка
# просто не генерируется. Ключ — https://console.anthropic.com/
# Хранить только в .env на сервере, никогда не коммитить.
ANTHROPIC_API_KEY=
